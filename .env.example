# Telegram bot token (BotFather)
TELEGRAM_BOT_TOKEN=TU_TOKEN_AQUI

# URL publica de tu instancia (sin / final), necesaria para archivos >49 MB
# Ejemplo: https://reclip.tudominio.com
RECLIP_BASE_URL=TU_URL_AQUI

# Dominio que usara Traefik para enrutar esta app
APP_DOMAIN=reclip.tudominio.com

# Traefik
TRAEFIK_ENABLE=true
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=letsencrypt

# Ruta del fichero ACL dentro del contenedor (mapeado al volumen ./data)
ACL_PATH=/app/data/acl.json

# Contrasena del panel de administracion (/admin)
ADMIN_PASSWORD=contraseña_segura_aqui

# Clave de sesion Flask
SECRET_KEY=una_clave_larga_aleatoria

# Cookies para sitios que requieren autenticacion (Instagram, etc.)
# Opcion A: exporta cookies.txt con una extension como "Get cookies.txt"
# y colocarlo en la carpeta de la app.
# Opcion B: usar cookies del navegador (chrome, brave, chromium, edge, firefox, safari)
# COOKIES_FROM_BROWSER=chrome

# Ruta personalizada del archivo de cookies (opcional, por defecto: ./cookies.txt)
# COOKIES_FILE=/app/cookies.txt

# App config
HOST=0.0.0.0
PORT=8899